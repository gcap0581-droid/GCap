{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/version.json",
      "destination": "/version.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
